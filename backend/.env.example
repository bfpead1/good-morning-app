# Copy this file to .env and fill in the values.

PORT=4000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client.
# In dev this goes through the Vite proxy so the login cookie lands on the frontend's origin.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# ── Optional ────────────────────────────────────────────────────────────────

# Enables AI features (daily plan, workout generator). Free API key at https://console.groq.com/keys
# Server-side only: never put this in frontend code.
GROQ_API_KEY=

# Must support strict structured outputs: openai/gpt-oss-120b, openai/gpt-oss-20b, or qwen/qwen3.8-27b.
# See https://console.groq.com/docs/structured-outputs
GROQ_MODEL=openai/gpt-oss-120b

# gpt-oss reasoning effort: low | medium | high. Higher may plan better but uses more of the free-tier token budget.
GROQ_REASONING_EFFORT=low

# Timezone for "today" and the morning job, and the local time (24h) the daily plan is generated.
APP_TIMEZONE=America/Denver
PLAN_JOB_TIME=05:30

# When both are set, data is stored in Supabase instead of backend/data/db.json.
# Supabase dashboard > Project Settings > API. Use the service_role key (server only, never in the frontend).
# Run the files in supabase/migrations/ in order (0001 through 0004) in the SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails allowed to sign in. Blank lets any Google account in,
# so set this before publishing the Google OAuth app.
ALLOWED_EMAILS=
